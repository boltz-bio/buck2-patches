+        })
+        .await;
+        assert!(
+            closed.is_ok(),
+            "the replayed stream closes once every event is acknowledged"
+        );
+        let events = (1 + actions + 2 + 1) as i64;
+        assert_eq!(
+            *streams.lock().unwrap(),
+            vec![
