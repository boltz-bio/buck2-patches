+        assert_eq!(missing, vec!["MISSING".to_owned(), "EMPTY".to_owned()]);
+
+        let (literal, none) = expand_bes_config_env_vars_reporting("x-literal=value", test_env);
+        assert_eq!((literal.as_str(), none.len()), ("x-literal=value", 0));
+    }
