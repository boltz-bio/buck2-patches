+fn first_metadata(metadata: &HashMap<String, String>, keys: &[&str]) -> Option<String> {
+    keys.iter().find_map(|key| {
+        metadata
+            .get(*key)
+            .filter(|value| !value.is_empty())
+            .cloned()
+    })
+}
