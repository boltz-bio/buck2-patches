+            name: Some(name.clone()),
+            load_duration: metrics.load_duration.clone(),
+            num_targets: metrics.num_targets,
+            computation_steps: metrics.computation_steps,
+            num_transitive_loads: None,
+            package_overhead: None,
+        })
+        .collect()
+}
