+            .iter()
+            .find_map(|section| {
+                if section.section_label != section_label {
+                    return None;
+                }
+                match section.section_type.as_ref() {
+                    Some(cl::command_line_section::SectionType::ChunkList(chunks)) => {
+                        Some(chunks.chunk.clone())
+                    }
+                    _ => None,
+                }
+            })
+            .unwrap_or_default()
+    }
