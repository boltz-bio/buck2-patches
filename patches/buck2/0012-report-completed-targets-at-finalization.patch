+/// A resolved target pattern that a build, test or install command requested: one target, every
+/// target in a package (`//pkg:`), or every target under a directory (`//pkg/...`).
+#[derive(Clone, Debug, Eq, PartialEq)]
+enum RequestedPattern {
+    Target(String),
+    Package(String),
+    Recursive(String),
+}
+
+impl RequestedPattern {
+    fn parse(pattern: &str) -> Option<Self> {
+        // A provider (`[name]`) or configuration (`?platform`) suffix narrows what the command
+        // builds of a target, not which target it requests.
+        let pattern = pattern.split(['[', '?']).next()?.trim();
+        let label = normalize_buck_label(pattern)?;
+        if let Some(base) = label.strip_suffix("...") {
+            let base = base
+                .strip_suffix('/')
+                .filter(|base| !base.ends_with('/'))
+                .unwrap_or(base);
+            return Some(Self::Recursive(base.to_owned()));
+        }
+        if let Some(package) = label.strip_suffix(':') {
+            return Some(Self::Package(package.to_owned()));
+        }
+        if !label.contains(':') {
+            // `//a/b` is `//a/b:b`.
+            let name = label.rsplit('/').next().unwrap_or_default().to_owned();
+            return Some(Self::Target(format!("{label}:{name}")));
+        }
+        Some(Self::Target(label))
+    }
+
+    fn matches(&self, label: &str) -> bool {
+        let package = label.split_once(':').map_or(label, |(package, _)| package);
+        match self {
+            Self::Target(target) => target == label,
+            Self::Package(base) => base == package,
+            Self::Recursive(base) => package
+                .strip_prefix(base.as_str())
+                .is_some_and(|rest| rest.is_empty() || rest.starts_with('/') || base.ends_with('/')),
+        }
+    }
+}
