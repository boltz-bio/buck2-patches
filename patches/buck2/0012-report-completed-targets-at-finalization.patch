+    fn remember_requested_patterns(&mut self, patterns: &buck2_data::ParsedTargetPatterns) {
+        let parsed = patterns
+            .target_patterns
+            .iter()
+            .filter_map(|pattern| RequestedPattern::parse(&pattern.value))
+            .collect::<Vec<_>>();
+        if !parsed.is_empty() {
+            self.requested_patterns = Some(parsed);
+        }
+    }
+
+    /// Whether a target gets target events: in a build, test or install command, only a target
+    /// its resolved patterns name; in any other command, or before the patterns are known, any.
+    fn is_requested(&self, label: &str) -> bool {
+        !self.builds_analyzed_targets
+            || self
+                .requested_patterns
+                .as_ref()
+                .is_none_or(|patterns| patterns.iter().any(|pattern| pattern.matches(label)))
+    }
+
+    /// A successful command closes each requested target it neither built nor tested as skipped,
+    /// never as built. A failed command leaves them open, as before.
+    fn close_unbuilt_requested_targets(&mut self, succeeded: bool) {
+        if !succeeded || !self.builds_analyzed_targets || self.requested_patterns.is_none() {
+            return;
+        }
+        let unbuilt = self
+            .analyzed_configured_events
+            .keys()
+            .filter(|key| !self.completed_targets.contains_key(key))
+            .cloned()
+            .collect::<Vec<_>>();
+        self.skipped_targets.extend(unbuilt);
+    }
+
+    /// A target whose analysis declared no actions has nothing left to build once a build or
+    /// test command finishes, so it completes successfully then, instead of staying "building".
+    /// Analysis-only commands complete nothing.
+    fn complete_action_less_targets(&mut self) {
+        let keys = std::mem::take(&mut self.action_less_targets);
+        if !self.builds_analyzed_targets {
+            return;
+        }
+        for key in keys {
+            self.completed_targets
+                .entry(key)
+                .or_insert(CompletedTargetState { success: true });
+        }
+    }
+
+    fn flush_analyzed_configured_events(&mut self, events: &mut Vec<bep::BuildEvent>) {
+        for (key, mut event) in std::mem::take(&mut self.analyzed_configured_events) {
+            if self.emitted_configured_targets.contains_key(&key.label) {
+                continue;
+            }
+            if !self.completed_targets.contains_key(&key) && !self.skipped_targets.contains(&key) {
+                event.children.clear();
+            }
+            self.push_configured_event(Some(event), events);
+        }
+    }
