+    /// Finalize an ended command when its client-side InvocationRecord never arrives.
+    /// The transport calls this only at its existing quiet-period or shutdown boundary.
+    pub(crate) fn finish_without_invocation_record(&mut self) -> Vec<bep::BuildEvent> {
+        let Some(mut logs) = self.fallback_build_tool_logs.take() else {
+            return Vec::new();
+        };
+        let mut events = Vec::new();
+        self.push_all_held_test_events(&mut events);
+        let mut configured = Vec::new();
+        self.flush_analyzed_configured_events(&mut configured);
+        self.prepare_completed_targets(&mut configured);
+        self.emit_pending_pattern_expanded(&[], &mut events, true);
+        events.extend(configured);
+        self.emit_completed_updates_for_actions(&mut events);
+        logs.last_message = true;
+        self.push_build_tool_logs(logs, &mut events);
+        self.record_event_graph(&events);
+        self.emit_aborted_events_for_missing_ids(&mut events);
+        events
+    }
