+    fn prepare_completed_targets(&mut self, events: &mut Vec<bep::BuildEvent>) {
+        let mut configured_by_label = BTreeMap::new();
+        for key in self.completed_targets.keys() {
+            let configured = configured_by_label
+                .entry(key.label.clone())
+                .or_insert_with(|| {
+                    self.emitted_configured_targets
+                        .get(&key.label)
+                        .and_then(|bytes| bep::BuildEvent::decode(bytes.as_slice()).ok())
+                        .unwrap_or_else(|| {
+                            configured_event(
+                                key.label.clone(),
+                                key.configuration.clone(),
+                                if self.target_test_statuses.contains_key(key) {
+                                    TEST_TARGET_KIND.to_owned()
+                                } else {
+                                    GENERIC_TARGET_KIND.to_owned()
+                                },
+                            )
+                        })
+                });
+            let child = target_completed_id(key.label.clone(), key.configuration.clone());
+            if !configured.children.contains(&child) {
+                configured.children.push(child);
+            }
+        }
+        for event in configured_by_label.into_values() {
+            self.push_configured_event(Some(event), events);
+        }
