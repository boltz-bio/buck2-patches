+    #[test]
+    fn invocation_record_preserves_resource_profile_without_completed_spans() {
+        let mut converter = BazelEventConverter::default();
+        for micros in [0, 1_000_000] {
+            converter.convert(
+                1,
+                &trace_event_at(
+                    0,
+                    0,
+                    micros,
+                    buck2_data::buck_event::Data::Instant(buck2_data::InstantEvent {
+                        data: Some(buck2_data::instant_event::Data::Snapshot(Box::new(
+                            buck2_data::Snapshot {
+                                buck2_user_cpu_us: micros as u64,
+                                buck2_rss: Some(64 * 1024 * 1024),
+                                ..Default::default()
+                            },
+                        ))),
+                    }),
+                ),
+            );
+        }
+        let events = converter.convert(
+            3,
+            &trace_event_at(
+                0,
+                0,
+                2_000_000,
+                buck2_data::buck_event::Data::Record(buck2_data::RecordEvent {
+                    data: Some(buck2_data::record_event::Data::InvocationRecord(Box::new(
+                        buck2_data::InvocationRecord {
+                            command_name: Some("build".to_owned()),
+                            command_duration: Some(prost_types::Duration {
+                                seconds: 2,
+                                nanos: 0,
+                            }),
+                            ..Default::default()
+                        },
+                    ))),
+                }),
+            ),
+        );
+        let logs = events
+            .iter()
+            .find_map(|event| match event.payload.as_ref() {
+                Some(build_event::Payload::BuildToolLogs(logs)) => Some(logs),
+                _ => None,
+            })
+            .expect("build tool logs event");
+        let profile = decode_profile_from_logs(logs);
+        let trace_events = profile["traceEvents"].as_array().unwrap();
+        assert!(
+            trace_events
+                .iter()
+                .any(|event| event["name"] == "buck2 build")
+        );
+        assert_eq!(
+            trace_events
+                .iter()
+                .filter(|event| event["ph"] == "C")
+                .count(),
+            3
+        );
+        let cpu = trace_events
+            .iter()
+            .find(|event| event["name"] == DAEMON_CPU_PROFILE_NAME)
+            .unwrap();
+        assert_eq!(cpu["ts"], 1_000_000);
+        assert_eq!(cpu["args"]["cpu"], 1.0);
+    }
+
+    #[test]
+    fn resource_profile_skips_duplicate_times_and_cpu_resets() {
+        let profile = CommandProfileBuilder {
+            snapshots: vec![
+                ProfileSnapshot {
+                    timestamp_us: 999,
+                    cpu_us: 100,
+                    rss_bytes: Some(1024),
+                },
+                ProfileSnapshot {
+                    timestamp_us: 1000,
+                    cpu_us: 101,
+                    rss_bytes: None,
+                },
+                ProfileSnapshot {
+                    timestamp_us: 1000,
+                    cpu_us: 200,
+                    rss_bytes: Some(2048),
+                },
+                ProfileSnapshot {
+                    timestamp_us: 1010,
+                    cpu_us: 1,
+                    rss_bytes: None,
+                },
+                ProfileSnapshot {
+                    timestamp_us: 1020,
+                    cpu_us: 6,
+                    rss_bytes: None,
+                },
+            ],
+            ..Default::default()
+        };
+        let events = profile.resource_events(1000);
+        assert_eq!(events.len(), 2);
+        assert_eq!(events[0]["ts"], 0);
+        assert_eq!(events[0]["args"]["cpu"], 1.0);
+        assert_eq!(events[1]["ts"], 20);
+        assert_eq!(events[1]["args"]["cpu"], 0.5);
+        assert!(
+            events
+                .iter()
+                .all(|event| event["name"] == DAEMON_CPU_PROFILE_NAME)
+        );
+    }
+
+    #[test]
+    fn resource_profile_bounds_snapshot_retention() {
+        let mut profile = CommandProfileBuilder::default();
+        let event = trace_event_at(
+            0,
+            0,
+            0,
+            buck2_data::buck_event::Data::Instant(buck2_data::InstantEvent::default()),
+        );
+        for _ in 0..=MAX_PROFILE_SNAPSHOTS {
+            profile.record_snapshot(&event, &buck2_data::Snapshot::default());
+        }
+        assert_eq!(profile.snapshots.len(), MAX_PROFILE_SNAPSHOTS);
+        assert_eq!(profile.dropped_snapshots, 1);
+        let value: serde_json::Value =
+            serde_json::from_str(&profile.profile_json(None).unwrap()).unwrap();
+        assert!(
+            value["traceEvents"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .any(|event| {
+                    event["name"] == "profile resource snapshots dropped"
+                        && event["args"]["dropped_snapshots"] == 1
+                })
+        );
+        let mut missing_timestamp = event;
+        missing_timestamp.timestamp = None;
+        profile.record_snapshot(&missing_timestamp, &buck2_data::Snapshot::default());
+        assert_eq!(profile.dropped_snapshots, 1);
     }

     #[test]
