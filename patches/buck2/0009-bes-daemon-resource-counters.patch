 impl CommandProfileBuilder {
+    fn record_snapshot(&mut self, event: &buck2_data::BuckEvent, snapshot: &buck2_data::Snapshot) {
+        let Some(timestamp_us) = timestamp_micros(event.timestamp.as_ref()) else {
+            return;
+        };
+        if self.snapshots.len() >= MAX_PROFILE_SNAPSHOTS {
+            self.dropped_snapshots = self.dropped_snapshots.saturating_add(1);
+            return;
+        }
+        self.snapshots.push(ProfileSnapshot {
+            timestamp_us,
+            cpu_us: snapshot_cpu_time_us(snapshot),
+            rss_bytes: snapshot.buck2_rss,
+        });
+    }
+
+    fn resource_events(&self, base_us: i64) -> Vec<serde_json::Value> {
+        // These snapshots cover only the daemon, not local actions or remote executors.
+        let mut snapshots: Vec<_> = self.snapshots.iter().collect();
+        snapshots.sort_by_key(|snapshot| snapshot.timestamp_us);
+        let mut events = Vec::new();
+        let mut previous: Option<&ProfileSnapshot> = None;
+        for snapshot in snapshots {
+            if previous.is_some_and(|previous| previous.timestamp_us == snapshot.timestamp_us) {
+                continue;
+            }
+            let baseline = previous.replace(snapshot);
+            if snapshot.timestamp_us < base_us {
+                continue;
+            }
+            let timestamp_us = snapshot.timestamp_us.saturating_sub(base_us);
+            if let Some(rss_bytes) = snapshot.rss_bytes {
+                events.push(serde_json::json!({
+                    "name": DAEMON_RSS_PROFILE_NAME,
+                    "cat": "resource_usage",
+                    "ph": "C",
+                    "ts": timestamp_us,
+                    "pid": 1,
+                    "tid": 0,
+                    "args": { "memory": rss_bytes as f64 / (1024.0 * 1024.0) },
+                }));
+            }
+            if let Some(baseline) = baseline
+                && let Some(cpu_us) = snapshot.cpu_us.checked_sub(baseline.cpu_us)
+                && let Some(elapsed_us) = snapshot.timestamp_us.checked_sub(baseline.timestamp_us)
+                && elapsed_us > 0
+            {
+                events.push(serde_json::json!({
+                    "name": DAEMON_CPU_PROFILE_NAME,
+                    "cat": "resource_usage",
+                    "ph": "C",
+                    "ts": timestamp_us,
+                    "pid": 1,
+                    "tid": 0,
+                    "args": { "cpu": cpu_us as f64 / elapsed_us as f64 },
+                }));
+            }
+        }
+        events
+    }
+
     fn record_span_start(
         &mut self,
         event: &buck2_data::BuckEvent,
@@ -2899,7 +2974,7 @@ impl CommandProfileBuilder {
