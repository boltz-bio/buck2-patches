+    #[test]
+    fn a_re_session_before_the_command_start_waits_for_it() {
+        let mut converter = BazelEventConverter::new_with_options(
+            [(
+                "DISABLE_COMMIT_STATUS_REPORTING".to_owned(),
+                "true".to_owned(),
+            )],
+            true,
+        );
+        let session = trace_event(buck2_data::buck_event::Data::Instant(
+            buck2_data::InstantEvent {
+                data: Some(buck2_data::instant_event::Data::ReSession(
+                    buck2_data::RemoteExecutionSessionCreated {
+                        session_id: "session".to_owned(),
+                        ..Default::default()
+                    },
+                )),
+            },
+        ));
+        assert!(converter.convert(1, &session).is_empty());
+        let start = trace_event(buck2_data::buck_event::Data::SpanStart(
+            buck2_data::SpanStartEvent {
+                data: Some(buck2_data::span_start_event::Data::Command(
+                    buck2_data::CommandStart {
+                        data: Some(buck2_data::command_start::Data::Build(
+                            buck2_data::BuildCommandStart {},
+                        )),
+                        metadata: HashMap::from([("COMMIT_SHA".to_owned(), "abc".to_owned())]),
+                        ..Default::default()
+                    },
+                )),
+            },
+        ));
+        let events = converter.convert(2, &start);
+        match events.first().and_then(|event| event.payload.as_ref()) {
+            Some(build_event::Payload::Started(started)) => assert_eq!(started.command, "build"),
+            other => panic!("expected Started first, got {other:?}"),
+        }
+        let metadata: Vec<_> = events
+            .iter()
+            .filter_map(|event| match event.payload.as_ref() {
+                Some(build_event::Payload::BuildMetadata(metadata)) => Some(metadata),
+                _ => None,
+            })
+            .collect();
+        assert!(matches!(
+            events[1].payload,
+            Some(build_event::Payload::BuildMetadata(_))
+        ));
+        assert_eq!(
+            metadata[0].metadata.get("COMMIT_SHA").map(String::as_str),
+            Some("abc")
+        );
+        assert!(
+            metadata
+                .iter()
+                .all(|m| m.metadata.get("DISABLE_COMMIT_STATUS_REPORTING").map(String::as_str)
+                    == Some("true"))
+        );
+        assert!(
+            metadata[1..]
+                .iter()
+                .any(|m| m.metadata.contains_key("BUCK2_RE_SESSION_ID"))
+        );
+    }
+
+    #[test]
+    fn a_command_names_its_own_pattern() {
+        let command = buck2_data::CommandStart {
+            data: Some(buck2_data::command_start::Data::Build(
+                buck2_data::BuildCommandStart {},
+            )),
+            cli_args: vec![
+                "buck2".to_owned(),
+                "build".to_owned(),
+                "@/tmp/targets".to_owned(),
+            ],
+            metadata: HashMap::from([("PATTERN".to_owned(), "//... images".to_owned())]),
+            ..Default::default()
+        };
+        assert_eq!(
+            target_patterns_from_cli(&command),
+            vec!["//...".to_owned(), "images".to_owned()]
+        );
+        let metadata = build_metadata_from_command(&command, &BTreeMap::new());
+        assert_eq!(metadata.get("PATTERN").map(String::as_str), Some("//... images"));
+    }
