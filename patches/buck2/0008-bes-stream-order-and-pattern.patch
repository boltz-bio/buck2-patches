@@ -4328,9 +4348,24 @@ fn build_metadata_event(metadata: &BTreeMap<String, String>) -> bep::BuildEvent
 }
 
 fn target_patterns_from_cli(command: &buck2_data::CommandStart) -> Vec<String> {
+    if let Some(pattern) = explicit_pattern(command) {
+        return pattern;
+    }
     target_patterns_from_args(&command.cli_args, &command_name(command))
 }
 
+/// The patterns a command names in its own PATTERN metadata, which a caller sets when its
+/// arguments say nothing readable, such as `@argfile` of thousands of labels.
+fn explicit_pattern(command: &buck2_data::CommandStart) -> Option<Vec<String>> {
+    let patterns: Vec<String> = command
+        .metadata
+        .get("PATTERN")?
+        .split_whitespace()
+        .map(str::to_owned)
+        .collect();
+    (!patterns.is_empty()).then_some(patterns)
+}
