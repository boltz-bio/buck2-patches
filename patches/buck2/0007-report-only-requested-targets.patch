+/// The completion of a requested target that the command did not build, as Bazel reports a
+/// skipped target: an Aborted event with reason SKIPPED, never a successful TargetComplete.
+fn skipped_completion_event(key: &TargetKey) -> bep::BuildEvent {
+    bep::BuildEvent {
+        id: Some(target_completed_id(key.label.clone(), key.configuration.clone())),
+        children: Vec::new(),
+        payload: Some(build_event::Payload::Aborted(bep::Aborted {
+            reason: bep::aborted::AbortReason::Skipped as i32,
+            description: "The command requested this target but did not build it.".to_owned(),
+        })),
+        last_message: false,
+    }
+}
