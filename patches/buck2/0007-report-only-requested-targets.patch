+    fn requested_patterns_match_targets_packages_and_directories() {
+        let pattern = |value: &str| RequestedPattern::parse(value).expect("pattern parses");
+        assert!(pattern("root//pkg:main").matches("//pkg:main"));
+        assert!(!pattern("root//pkg:main").matches("//pkg:other"));
+        assert!(pattern("root//pkg:main[sub]").matches("//pkg:main"));
+        assert!(pattern("root//pkg:main?root//platforms:linux").matches("//pkg:main"));
+        assert!(pattern("root//pkg").matches("//pkg:pkg"));
+        assert!(pattern("root//pkg:").matches("//pkg:any"));
+        assert!(!pattern("root//pkg:").matches("//pkg/sub:any"));
+        assert!(pattern("root//pkg/...").matches("//pkg:a"));
+        assert!(pattern("root//pkg/...").matches("//pkg/sub:b"));
+        assert!(!pattern("root//pkg/...").matches("//pkgs:c"));
+        assert!(pattern("root//...").matches("//any/where:x"));
+        assert!(!pattern("root//...").matches("@prelude//cxx:x"));
+        assert!(pattern("prelude//cxx/...").matches("@prelude//cxx/tools:x"));
+    }
