@@ -99,6 +99,49 @@ pub(crate) fn any_artifact_methods(builder: &mut MethodsBuilder) {
 
 #[starlark_module]
 fn input_artifact_methods(builder: &mut MethodsBuilder) {
+    /// The complete path of a source artifact relative to its original cell root, or
+    /// `None` for a build artifact, including an unbound declared artifact.
+    /// Includes its package and all projected paths; `project(hide_prefix = True)`
+    /// only changes `short_path`. This is a logical path, not an execution path.
+    /// Pair with `source_cell` to identify a source across exports and cell aliases;
+    /// use `cmd_args` to render its physical path for an action.
+    #[starlark(attribute)]
+    fn source_path<'v>(
+        this: &'v dyn StarlarkInputArtifactLike<'v>,
+        heap: Heap<'v>,
+    ) -> starlark::Result<NoneOr<StringValue<'v>>> {
+        if !this.is_source()? {
+            return Ok(NoneOr::None);
+        }
+        let artifact = this.get_bound_artifact()?;
+        Ok(NoneOr::Other(
+            artifact
+                .get_path()
+                .with_full_path(|path| heap.alloc_str(path.as_str())),
+        ))
+    }
+
+    /// The canonical name of a source artifact's original cell, or `None` for a
+    /// build artifact, including an unbound declared artifact. Exporting a source
+    /// through another target or cell does not change this name. Cell aliases
+    /// resolve to the same canonical name. Pair with `source_path` for identity.
+    #[starlark(attribute)]
+    fn source_cell<'v>(
+        this: &'v dyn StarlarkInputArtifactLike<'v>,
+        heap: Heap<'v>,
+    ) -> starlark::Result<NoneOr<StringValue<'v>>> {
+        if !this.is_source()? {
+            return Ok(NoneOr::None);
+        }
+        let artifact = this.get_bound_artifact()?;
+        let source = artifact
+            .get_source()
+            .expect("Source artifacts have a source path");
+        Ok(NoneOr::Other(heap.alloc_str(
+            source.get_path().package().cell_name().as_str(),
+        )))
+    }
+
     /// Returns an `OutputArtifact` instance, or fails if the artifact is
     /// either an `Artifact`, or is a bound `Artifact` (You cannot bind twice)
     fn as_output<'v>(
