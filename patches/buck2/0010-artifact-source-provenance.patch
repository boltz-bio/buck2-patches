+#[test]
+fn source_artifact_provenance() -> buck2_error::Result<()> {
+    let mut tester = Tester::new()?;
+    tester.additional_globals(artifactory);
+    tester.run_starlark_bzl_test(indoc!(
+        r#"
+            frozen_source = source_artifact("foo/bar", "nested/file.py")
+            frozen_projection = frozen_source.project("child", hide_prefix = True)
+
+            def test():
+                assert_eq("root", frozen_source.source_cell)
+                assert_eq("foo/bar/nested/file.py", frozen_source.source_path)
+                assert_eq("root", frozen_projection.source_cell)
+                assert_eq("foo/bar/nested/file.py/child", frozen_projection.source_path)
+                assert_eq("child", frozen_projection.short_path)
+
+                source = source_artifact_in_cell("other//original/package", "directory")
+                assert_eq("other", source.source_cell)
+                assert_eq("original/package/directory", source.source_path)
+                projected = source.project("nested").project("file.txt", hide_prefix = True)
+                assert_eq("file.txt", projected.short_path)
+                assert_eq("original/package/directory/nested/file.txt", projected.source_path)
+                assert_eq("other", projected.source_cell)
+                assert_eq(None, projected.owner)
+
+                root_file = source_artifact_in_cell("other//", "file.txt")
+                assert_eq("file.txt", root_file.source_path)
+                assert_eq("other", root_file.source_cell)
+            "#
+    ))
+}
+
+#[test]
+fn build_artifact_source_provenance_is_none() -> buck2_error::Result<()> {
+    let mut tester = Tester::new()?;
+    tester.additional_globals(artifactory);
+    tester.run_starlark_bzl_test(indoc!(
+        r#"
+            frozen_output = bound_artifact("//foo:bar", "generated.txt")
+
+            def test():
+                outputs = [
+                    frozen_output,
+                    bound_artifact("//foo:bar", "bound.txt"),
+                    declared_artifact("unbound.txt"),
+                    declared_bound_artifact("//foo:bar", "declared.txt"),
+                ]
+                for output in outputs:
+                    assert_eq(None, output.source_path)
+                    assert_eq(None, output.source_cell)
+                    projected = output.project("child", hide_prefix = True)
+                    assert_eq(None, projected.source_path)
+                    assert_eq(None, projected.source_cell)
+            "#
+    ))
+}
+
