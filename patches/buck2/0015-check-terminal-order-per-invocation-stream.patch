+    fn retained_progress_precedes_finish(
+        events: &[bazel_bep_proto::build_event_stream::BuildEvent],
+        marker: &str,
+    ) -> bool {
+        use bazel_bep_proto::build_event_stream::build_event::Payload;
+        let progress = events.iter().position(|event| {
+            matches!(
+                event.payload.as_ref(), Some(Payload::Progress(progress))
+                    if progress.stdout.contains(marker) || progress.stderr.contains(marker)
+            )
+        });
+        let finished = events
+            .iter()
+            .position(|event| matches!(event.payload, Some(Payload::Finished(_))));
+        matches!((progress, finished), (Some(progress), Some(finished)) if progress < finished)
+    }
+
+    #[test]
+    fn accepted_progress_order_is_scoped_to_each_stream() {
+        use bazel_bep_proto::build_event_stream::BuildEvent;
+        use bazel_bep_proto::build_event_stream::BuildFinished;
+        use bazel_bep_proto::build_event_stream::Progress;
+        use bazel_bep_proto::build_event_stream::build_event::Payload;
+        let progress = |marker: &str| BuildEvent {
+            payload: Some(Payload::Progress(Progress {
+                stdout: marker.to_owned(),
+                ..Default::default()
+            })),
+            ..Default::default()
+        };
+        let finished = BuildEvent {
+            payload: Some(Payload::Finished(BuildFinished::default())),
+            ..Default::default()
+        };
+        let events = [
+            progress("first retained result"),
+            finished.clone(),
+            progress("second retained result"),
+            finished.clone(),
+        ];
+        // Every interleaving preserves FIFO within each independent gRPC invocation stream.
+        for order in [
+            [0, 1, 2, 3],
+            [0, 2, 1, 3],
+            [0, 2, 3, 1],
+            [2, 0, 1, 3],
+            [2, 0, 3, 1],
+            [2, 3, 0, 1],
+        ] {
+            for (stream, marker) in ["first retained result", "second retained result"]
+                .iter()
+                .enumerate()
+            {
+                let owned = order
+                    .iter()
+                    .filter(|index| **index / 2 == stream)
+                    .map(|index| events[*index].clone())
+                    .collect::<Vec<_>>();
+                assert!(
+                    retained_progress_precedes_finish(&owned, marker),
+                    "order={order:?}, stream={stream}"
+                );
+            }
+        }
+        assert!(
+            !retained_progress_precedes_finish(
+                &[finished.clone(), progress("first retained result")],
+                "first retained result"
+            ),
+            "within-stream reordering must fail"
+        );
+        assert!(
+            !retained_progress_precedes_finish(&[finished], "first retained result"),
+            "missing accepted progress must fail"
+        );
+        assert!(
+            !retained_progress_precedes_finish(
+                &[progress("first retained result")],
+                "first retained result"
+            ),
+            "missing terminal event must fail"
+        );
+        assert!(
+            !retained_progress_precedes_finish(
+                &[progress("second retained result"), events[1].clone()],
+                "first retained result"
+            ),
+            "another invocation's progress cannot satisfy the check"
+        );
+    }
+
