+//! Declare test output directories and export materialized results through a versioned NUL-delimited manifest.
+
+use std::collections::BTreeSet;
+use std::fs::File;
+use std::io::BufWriter;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+use buck2_error::BuckErrorContext;
+use buck2_error::ErrorTag;
+use buck2_error::buck2_error;
+use buck2_test_api::data::ArgValue;
+use buck2_test_api::data::ArgValueContent;
+use buck2_test_api::data::DeclaredOutput;
+use buck2_test_api::data::ExecutionResult2;
+use buck2_test_api::data::Output;
+use buck2_test_api::data::OutputName;
+use buck2_test_api::data::RemoteStorageConfig;
+use buck2_test_api::data::TestStatus;
+use parking_lot::Mutex;
+
+const HEADER: &[u8] = b"buck2-test-outputs-v1\0";
+
+#[derive(Debug, Clone, PartialEq)]
+pub(crate) struct OutputEnv {
+    name: String,
+    directory: String,
+}
+
+impl OutputEnv {
+    pub(crate) fn parse_all(values: &[String]) -> buck2_error::Result<Vec<Self>> {
+        let mut names = BTreeSet::new();
+        let mut directories = BTreeSet::new();
+        values.iter().map(|value| {
+            let (name, directory) = value.split_once('=').ok_or_else(|| buck2_error!(ErrorTag::Input, "Output environment requires ENV=relative-directory"))?;
+            let mut characters = name.bytes();
+            if !characters.next().is_some_and(|c| c.is_ascii_alphabetic() || c == b'_')
+                || !characters.all(|c| c.is_ascii_alphanumeric() || c == b'_')
+                || directory.contains(['\\', '\0', ':'])
+                || directory.split('/').any(|part| part.is_empty() || part == "." || part == "..")
+            {
+                return Err(buck2_error!(ErrorTag::Input, "Output environment needs a valid environment name and a nonempty relative directory without traversal"));
+            }
+            if !names.insert(name.to_owned()) || !directories.insert(directory.to_owned()) {
+                return Err(buck2_error!(ErrorTag::Input, "Output environment names and directories must be distinct"));
+            }
+            Ok(Self { name: name.to_owned(), directory: directory.to_owned() })
+        }).collect()
+    }
+
+    pub(crate) fn environment(&self) -> (String, ArgValue) {
+        (
+            self.name.clone(),
+            ArgValue {
+                content: ArgValueContent::DeclaredOutput(OutputName::unchecked_new(
+                    self.directory.clone(),
+                )),
+                format: None,
+            },
+        )
+    }
+
+    pub(crate) fn declaration(&self) -> DeclaredOutput {
+        DeclaredOutput::unchecked_new(self.directory.clone(), RemoteStorageConfig::new(false))
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct OutputsManifest {
+    records: Mutex<Vec<[String; 4]>>,
+    root: Option<PathBuf>,
+    next_output: AtomicU64,
+}
+
+impl OutputsManifest {
+    pub(crate) fn new(manifest: Option<&Path>) -> buck2_error::Result<Self> {
+        let root = manifest
+            .map(|path| {
+                let mut directory = std::path::absolute(path)?.into_os_string();
+                directory.push(".d");
+                let directory = PathBuf::from(directory);
+                std::fs::create_dir(&directory)
+                    .buck_error_context("Test output destination must be a fresh directory")?;
+                buck2_error::Ok(directory)
+            })
+            .transpose()?;
+        Ok(Self {
+            root,
+            ..Self::default()
+        })
+    }
+
+    pub(crate) fn record_result(
+        &self,
+        target: &str,
+        status: &TestStatus,
+        result: &ExecutionResult2,
+    ) -> buck2_error::Result<()> {
+        let outputs = result
+            .outputs
+            .iter()
+            .map(|(name, output)| {
+                let Output::LocalPath(path) = output else {
+                    return Err(buck2_error!(
+                        ErrorTag::Input,
+                        "Declared test output was not materialized by the orchestrator"
+                    ));
+                };
+                let root = self.root.as_ref().ok_or_else(|| {
+                    buck2_error!(
+                        ErrorTag::Input,
+                        "Output retention requires a manifest destination"
+                    )
+                })?;
+                let destination =
+                    root.join(self.next_output.fetch_add(1, Ordering::Relaxed).to_string());
+                copy_output(Path::new(path.as_os_str()), &destination)?;
+                let destination = destination.to_str().ok_or_else(|| {
+                    buck2_error!(ErrorTag::Input, "Output manifest paths must be valid UTF-8")
+                })?;
+                Ok((name.as_str().to_owned(), destination.to_owned()))
+            })
+            .collect::<buck2_error::Result<Vec<_>>>()?;
+        self.record(target, status, outputs)
+    }
+
+    pub(crate) fn record_cancelled(&self, target: &str) -> buck2_error::Result<()> {
+        self.record(target, &TestStatus::OMITTED, Vec::new())
+    }
+
+    fn record(
+        &self,
+        target: &str,
+        status: &TestStatus,
+        mut outputs: Vec<(String, String)>,
+    ) -> buck2_error::Result<()> {
+        if outputs.is_empty() {
+            outputs.push((String::new(), String::new()));
+        }
+        let status = format!("{status:?}");
+        let records = outputs
+            .into_iter()
+            .map(|(name, path)| [target.to_owned(), status.clone(), name, path])
+            .collect::<Vec<_>>();
+        if records.iter().flatten().any(|value| value.contains('\0')) {
+            return Err(buck2_error!(
+                ErrorTag::Input,
+                "Test output manifest fields cannot contain NUL"
+            ));
+        }
+        self.records.lock().extend(records);
+        Ok(())
+    }
+
+    fn write_to(&self, writer: &mut impl Write) -> buck2_error::Result<()> {
+        let mut records = self.records.lock().clone();
+        records.sort_by(|left, right| {
+            left[0]
+                .cmp(&right[0])
+                .then(left[2].cmp(&right[2]))
+                .then(left[1].cmp(&right[1]))
+                .then(left[3].cmp(&right[3]))
+        });
+        writer.write_all(HEADER)?;
+        for record in records {
+            for field in record {
+                writer.write_all(field.as_bytes())?;
+                writer.write_all(b"\0")?;
+            }
+        }
+        writer.flush()?;
+        Ok(())
+    }
+
+    pub(crate) fn write(&self, path: &Path) -> buck2_error::Result<()> {
+        let file =
+            File::create(path).buck_error_context("Could not create test outputs manifest")?;
+        self.write_to(&mut BufWriter::new(file))
+    }
+}
+
+// Test output leases end with the runner session, so retain only the paths the
+// public execution response returned before reporting the test as finished.
+fn copy_output(source: &Path, destination: &Path) -> buck2_error::Result<()> {
+    let metadata = std::fs::symlink_metadata(source)?;
+    if metadata.is_dir() {
+        std::fs::create_dir(destination)?;
+        for entry in std::fs::read_dir(source)? {
+            let entry = entry?;
+            copy_output(&entry.path(), &destination.join(entry.file_name()))?;
+        }
+    } else if metadata.is_file() {
+        std::fs::copy(source, destination)?;
+    } else {
+        return Err(buck2_error!(
+            ErrorTag::Input,
+            "Declared test outputs must contain only regular files and directories"
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn temporary_directory() -> PathBuf {
+        let timestamp = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let path = std::env::temp_dir().join(format!(
+            "buck2-output-test-{}-{timestamp}",
+            std::process::id()
+        ));
+        std::fs::create_dir(&path).unwrap();
+        path
+    }
+
+    #[test]
+    fn retained_files_survive_the_original_materialization_lifetime() {
+        let temporary = temporary_directory();
+        let source = temporary.join("ephemeral");
+        std::fs::create_dir_all(source.join("argos")).unwrap();
+        std::fs::write(source.join("argos/image.png"), b"retained screenshot").unwrap();
+        let manifest = OutputsManifest::new(Some(&temporary.join("manifest"))).unwrap();
+        let retained = manifest.root.as_ref().unwrap().join("0");
+        copy_output(&source, &retained).unwrap();
+        std::fs::remove_dir_all(source).unwrap();
+        assert_eq!(
+            std::fs::read(retained.join("argos/image.png")).unwrap(),
+            b"retained screenshot"
+        );
+        assert!(OutputsManifest::new(Some(&temporary.join("manifest"))).is_err());
+        std::fs::remove_dir_all(temporary).unwrap();
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn retention_rejects_symlinks_and_preserves_existing_destinations() {
+        let temporary = temporary_directory();
+        let sibling = temporary.join("sibling");
+        std::fs::write(&sibling, b"private sibling").unwrap();
+        let source = temporary.join("symlink");
+        std::os::unix::fs::symlink(&sibling, &source).unwrap();
+        assert!(copy_output(&source, &temporary.join("retained")).is_err());
+        std::os::unix::fs::symlink(&sibling, temporary.join("manifest.d")).unwrap();
+        assert!(OutputsManifest::new(Some(&temporary.join("manifest"))).is_err());
+        assert_eq!(std::fs::read(sibling).unwrap(), b"private sibling");
+        assert!(!temporary.join("retained").exists());
+        std::fs::remove_dir_all(temporary).unwrap();
+    }
+
+    #[test]
+    fn outputs_use_materialized_declared_directories() {
+        let values = OutputEnv::parse_all(&["CAPTURES=artifacts/images".to_owned()]).unwrap();
+        assert_eq!(values[0].declaration().name.as_str(), "artifacts/images");
+        assert!(
+            !values[0]
+                .declaration()
+                .remote_storage_config
+                .supports_remote
+        );
+        let (name, value) = values[0].environment();
+        assert_eq!(name, "CAPTURES");
+        assert!(
+            matches!(value.content, ArgValueContent::DeclaredOutput(ref output) if output.as_str() == "artifacts/images")
+        );
+    }
+
+    #[test]
+    fn invalid_or_duplicate_output_declarations_are_rejected() {
+        for value in [
+            "MISSING",
+            "=x",
+            "9ENV=x",
+            "ENV=",
+            "ENV=/absolute",
+            "ENV=C:/absolute",
+            "ENV=../sibling",
+            "ENV=a/../b",
+            "ENV=a/./b",
+            "ENV=a//b",
+            "ENV=a\\b",
+            "ENV=a\0b",
+        ] {
+            assert!(
+                OutputEnv::parse_all(&[value.to_owned()]).is_err(),
+                "{value:?}"
+            );
+        }
+        assert!(OutputEnv::parse_all(&["ENV=a".to_owned(), "ENV=b".to_owned()]).is_err());
+        assert!(OutputEnv::parse_all(&["FIRST=a".to_owned(), "SECOND=a".to_owned()]).is_err());
+    }
+
+    #[test]
+    fn manifests_preserve_status_unicode_and_delimiters_in_paths() {
+        let manifest = OutputsManifest::default();
+        manifest
+            .record(
+                "root//pkg:second",
+                &TestStatus::FAIL,
+                vec![("images".to_owned(), "/tmp/a\tb\n雪".to_owned())],
+            )
+            .unwrap();
+        manifest
+            .record("root//pkg:first", &TestStatus::PASS, Vec::new())
+            .unwrap();
+        manifest.record_cancelled("root//pkg:third").unwrap();
+        let mut bytes = Vec::new();
+        manifest.write_to(&mut bytes).unwrap();
+        assert_eq!(
+            String::from_utf8(bytes).unwrap(),
+            "buck2-test-outputs-v1\0root//pkg:first\0PASS\0\0\0root//pkg:second\0FAIL\0images\0/tmp/a\tb\n雪\0root//pkg:third\0OMITTED\0\0\0"
+        );
+    }
+
+    #[test]
+    fn malformed_fields_fail_without_partial_results() {
+        let manifest = OutputsManifest::default();
+        assert!(
+            manifest
+                .record(
+                    "root//pkg:name",
+                    &TestStatus::PASS,
+                    vec![("bad\0name".to_owned(), "/tmp/output".to_owned())]
+                )
+                .is_err()
+        );
+        assert!(manifest.records.lock().is_empty());
+    }
+}
