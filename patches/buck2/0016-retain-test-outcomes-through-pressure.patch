+    fn retained_ingress_shares_quota_releases_files_and_rejects_corruption() {
+        let scratch = tempfile::tempdir().expect("scratch");
+        let budget = Arc::new(SpillBudget {
+            max_bytes: 1 << 20,
+            used_bytes: AtomicU64::new(0),
+        });
+        let mut state = RetainedMessages::new(Some(SpillTarget {
+            dir: scratch.path().to_owned(),
+            budget: budget.clone(),
+        }));
+        let ids = [TraceId::new().to_string(), TraceId::new().to_string()];
+        for (index, id) in ids.iter().enumerate() {
+            assert_eq!(
+                state
+                    .push(
+                        make_message(Some(id), Some(index as i64), command_end_data()),
+                        index
+                    )
+                    .unwrap(),
+                index == 0
+            );
+        }
+        let file = state.file.as_ref().unwrap();
+        let path = file.path.clone();
+        assert!(budget.used_bytes.load(Ordering::Relaxed) > 0);
+        #[cfg(unix)]
+        {
+            assert_eq!(
+                std::fs::metadata(&path).unwrap().permissions().mode() & 0o777,
+                0o600
+            );
+        }
+        assert!(
+            !budget.try_reserve(budget.max_bytes),
+            "replay shares retained quota"
+        );
+        for (index, id) in ids.iter().enumerate() {
+            let retained = state.pop().unwrap().unwrap();
+            assert_eq!(retained.queued_before, index);
+            assert_eq!(retained.message.message_key, Some(index as i64));
+            assert_eq!(
+                ParsedMessage::from_message(&retained.message)
+                    .unwrap()
+                    .invocation_id,
+                *id
+            );
+        }
+        assert!(!path.exists());
+        assert_eq!(budget.used_bytes.load(Ordering::Relaxed), 0);
+        assert!(state.pop().unwrap().is_none());
+        state.notified = false;
+        state
+            .push(make_message(Some(&ids[0]), Some(9), command_end_data()), 0)
+            .unwrap();
+        let path = state.file.as_ref().unwrap().path.clone();
+        std::fs::write(&path, u64::MAX.to_le_bytes()).unwrap();
+        assert!(
+            state.pop().is_err(),
+            "corrupt length must fail before allocating payload"
+        );
+        drop(state);
+        assert!(!path.exists());
+        assert_eq!(budget.used_bytes.load(Ordering::Relaxed), 0);
+    }
