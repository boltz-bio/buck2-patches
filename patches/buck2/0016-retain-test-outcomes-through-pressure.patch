+// Outcome and invocation context must survive pressure from ordinary action/progress events.
+#[cfg(not(fbcode_build))]
+fn retain_bazel_outcome_context(data: &buck2_data::buck_event::Data) -> bool {
+    use buck2_data::buck_event::Data;
+    match data {
+        Data::SpanStart(span) => matches!(
+            span.data.as_ref(),
+            Some(
+                buck2_data::span_start_event::Data::Command(_)
+                    | buck2_data::span_start_event::Data::CommandCritical(_)
+                    | buck2_data::span_start_event::Data::Analysis(_)
+                    | buck2_data::span_start_event::Data::TestDiscovery(_)
+                    | buck2_data::span_start_event::Data::TestRun(_)
+            )
+        ),
+        Data::SpanEnd(span) => matches!(
+            span.data.as_ref(),
+            Some(
+                buck2_data::span_end_event::Data::Command(_)
+                    | buck2_data::span_end_event::Data::Analysis(_)
+                    | buck2_data::span_end_event::Data::TestDiscovery(_)
+                    | buck2_data::span_end_event::Data::TestRun(_)
+            )
+        ),
+        Data::Instant(instant) => matches!(
+            instant.data.as_ref(),
+            Some(
+                buck2_data::instant_event::Data::TestDiscovery(_)
+                    | buck2_data::instant_event::Data::TestResult(_)
+                    | buck2_data::instant_event::Data::EndOfTestResults(_)
+                    | buck2_data::instant_event::Data::TargetPatterns(_)
+                    | buck2_data::instant_event::Data::TargetCfg(_)
+                    | buck2_data::instant_event::Data::CommandOptions(_)
+                    | buck2_data::instant_event::Data::VersionControlRevision(_)
+                    | buck2_data::instant_event::Data::BuckconfigInputValues(_)
+            )
+        ),
+        Data::Record(record) => matches!(
+            record.data.as_ref(),
+            Some(buck2_data::record_event::Data::InvocationRecord(_))
+        ),
