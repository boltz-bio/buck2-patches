+    /// Retains outcome/context/finality events without waiting on the BES network. Disk
+    /// storage shares the replay quota; refusal is explicit in the next drain response.
+    pub fn offer_retained(&self, message: Message) {
+        let mut retained = self.retained.lock().expect("retained ingress lock");
+        let message = if retained.file.is_none() && !retained.draining {
+            match self.tx.try_send(message) {
+                Ok(()) => {
+                    self.counters.inc_queue_depth();
+                    return;
+                }
+                Err(crossbeam_channel::TrySendError::Full(message)) => message,
+                Err(crossbeam_channel::TrySendError::Disconnected(_)) => {
+                    retained.fail("worker disconnected");
+                    self.counters.inc_failures_enqueue_failed();
+                    self.counters.inc_dropped();
+                    return;
+                }
+            }
+        } else {
+            message
+        };
+        match retained.push(message, self.tx.len()) {
+            Ok(true) => {
+                if self
+                    .send_now_tx
+                    .send(WorkerRequest::Retained(self.retained.clone()))
+                    .is_err()
+                {
+                    retained.fail("worker disconnected");
+                    self.counters.inc_failures_enqueue_failed();
+                    self.counters.inc_dropped();
+                }
+            }
+            Ok(false) => {}
+            Err(error) => {
+                retained.fail(error);
+                if retained
+                    .file
+                    .as_ref()
+                    .is_some_and(|file| file.remaining == 0)
+                {
+                    retained.file = None;
+                }
+                self.counters.inc_failures_enqueue_failed();
+                self.counters.inc_dropped();
+            }
         }
     }
 
