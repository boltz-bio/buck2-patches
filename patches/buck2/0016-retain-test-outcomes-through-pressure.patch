+// Only a single wake-up is queued for this disk-backed FIFO. Routing every test event
+// through the unbounded priority channel would move queue pressure into unbounded RAM.
+#[derive(serde::Serialize, serde::Deserialize)]
+struct RetainedMessage {
+    message: Message,
+    queued_before: usize,
+}
+
+struct RetainedFile {
+    path: PathBuf,
+    file: std::fs::File,
+    bytes: u64,
+    read_offset: u64,
+    remaining: usize,
+    budget: Arc<SpillBudget>,
+}
+
+impl Drop for RetainedFile {
+    fn drop(&mut self) {
+        match std::fs::remove_file(&self.path) {
+            Ok(()) => self.budget.release(self.bytes),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                self.budget.release(self.bytes)
+            }
+            Err(error) => {
+                tracing::warn!("BES sink: could not remove retained ingress file: {error}")
+            }
+        }
+    }
+}
+
+struct RetainedMessages {
+    target: Option<SpillTarget>,
+    file: Option<RetainedFile>,
+    notified: bool,
+    draining: bool,
+    failures: u64,
+}
+
+impl RetainedMessages {
+    fn new(target: Option<SpillTarget>) -> Self {
+        Self {
+            target,
+            file: None,
+            notified: false,
+            draining: false,
+            failures: 0,
+        }
+    }
+
+    fn push(&mut self, message: Message, queued_before: usize) -> Result<bool, SpillRefusal> {
+        if self.failures != 0 {
+            return Err(SpillRefusal::Io(std::io::Error::other(
+                "retained ingress already failed",
+            )));
+        }
+        let target = self.target.as_ref().ok_or_else(|| {
+            SpillRefusal::Io(std::io::Error::other(
+                "retained ingress requires a replay spill directory",
+            ))
+        })?;
+        let encoded = serde_json::to_vec(&RetainedMessage {
+            message,
+            queued_before,
+        })
+        .map_err(|error| SpillRefusal::Io(std::io::Error::other(error)))?;
+        let bytes = 8 + encoded.len() as u64;
+        if self.file.is_none() {
+            std::fs::create_dir_all(&target.dir).map_err(SpillRefusal::Io)?;
+            let path = target
+                .dir
+                .join(format!("ingress-{}.bin", uuid::Uuid::new_v4()));
+            let mut options = std::fs::OpenOptions::new();
+            options.create_new(true).read(true).write(true);
+            #[cfg(unix)]
+            {
+                options.mode(0o600);
+            }
+            let file = options.open(&path).map_err(SpillRefusal::Io)?;
+            self.file = Some(RetainedFile {
+                path,
+                file,
+                bytes: 0,
+                read_offset: 0,
+                remaining: 0,
+                budget: target.budget.clone(),
+            });
+        }
+        if !target.budget.try_reserve(bytes) {
+            return Err(SpillRefusal::Full {
+                max_bytes: target.budget.max_bytes,
+            });
+        }
+        let file = self.file.as_mut().expect("created retained file");
+        // Keep partial writes charged until the file is removed too.
+        file.bytes += bytes;
+        std::io::Seek::seek(&mut file.file, std::io::SeekFrom::End(0))
+            .and_then(|_| {
+                std::io::Write::write_all(&mut file.file, &(encoded.len() as u64).to_le_bytes())
+            })
+            .and_then(|_| std::io::Write::write_all(&mut file.file, &encoded))
+            .map_err(SpillRefusal::Io)?;
+        file.remaining += 1;
+        let notify = !self.notified;
+        self.notified = true;
+        Ok(notify)
+    }
+
+    fn pop(&mut self) -> std::io::Result<Option<RetainedMessage>> {
+        let Some(file) = self.file.as_mut() else {
+            return Ok(None);
+        };
+        if file.remaining == 0 {
+            return Ok(None);
+        }
+        std::io::Seek::seek(&mut file.file, std::io::SeekFrom::Start(file.read_offset))?;
+        let mut header = [0u8; 8];
+        file.file.read_exact(&mut header)?;
+        let len = u64::from_le_bytes(header);
+        if len > file.bytes.saturating_sub(file.read_offset + 8) {
+            return Err(std::io::Error::other("invalid retained ingress length"));
+        }
+        let mut encoded = vec![0; usize::try_from(len).map_err(std::io::Error::other)?];
+        file.file.read_exact(&mut encoded)?;
+        let message = serde_json::from_slice(&encoded).map_err(std::io::Error::other)?;
+        file.read_offset += 8 + len;
+        file.remaining -= 1;
+        if file.remaining == 0 {
+            self.file = None;
+        }
+        Ok(Some(message))
+    }
+
+    fn fail(&mut self, error: impl std::fmt::Display) {
+        self.failures += 1;
+        if self.failures == 1 {
+            tracing::warn!("BES sink: retained ingress is incomplete: {error}");
+        }
+    }
+}
