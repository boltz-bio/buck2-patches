+    #[test]
+    fn a_command_naming_many_targets_requests_each_of_them() {
+        let labels = (0..40_000)
+            .map(|index| format!("root//pkg{}:target_{index:05}", index % 97))
+            .collect::<Vec<_>>();
+        let mut converter = BazelEventConverter::default();
+        converter.builds_analyzed_targets = true;
+        // Wider than the 512 KiB the sink lets other consumers see.
+        assert!(labels.iter().map(String::len).sum::<usize>() > 512 * 1024);
+        converter.remember_requested_patterns(&buck2_data::ParsedTargetPatterns {
+            target_patterns: labels
+                .iter()
+                .map(|value| buck2_data::TargetPattern {
+                    value: value.clone(),
+                })
+                .collect(),
+        });
+        let last = labels
+            .last()
+            .and_then(|label| label.strip_prefix("root"))
+            .expect("root label");
+        assert!(converter.is_requested(last));
+        assert!(!converter.is_requested("//pkg0:target_99999"));
     }
 
     #[test]
