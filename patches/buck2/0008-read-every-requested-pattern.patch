+/// The targets a build, test or install command requested, indexed so that a command naming
+/// tens of thousands of targets, as a CI run's argfile does, matches each label in a few lookups.
+#[derive(Clone, Debug, Default)]
+struct RequestedTargets {
+    targets: HashSet<String>,
+    packages: HashSet<String>,
+    /// The directories `//pkg/...` names, keyed by `RequestedPattern::Recursive`'s base.
+    directories: HashSet<String>,
+}
+
+impl RequestedTargets {
+    /// The requested set, or none when the patterns are empty or the sink cut the list short
+    /// (`<<Truncated ...>>`), so that no requested target loses its events.
+    fn from_patterns<'a>(values: impl IntoIterator<Item = &'a str>) -> Option<Self> {
+        let mut requested = Self::default();
+        let mut any = false;
+        for value in values {
+            if value.starts_with("<<Truncated") {
+                return None;
+            }
+            match RequestedPattern::parse(value) {
+                Some(RequestedPattern::Target(target)) => requested.targets.insert(target),
+                Some(RequestedPattern::Package(package)) => requested.packages.insert(package),
+                Some(RequestedPattern::Recursive(base)) => requested.directories.insert(base),
+                None => continue,
+            };
+            any = true;
+        }
+        any.then_some(requested)
+    }
 
-    fn matches(&self, label: &str) -> bool {
+    fn contains(&self, label: &str) -> bool {
+        if self.targets.contains(label) {
+            return true;
+        }
         let package = label.split_once(':').map_or(label, |(package, _)| package);
-        match self {
-            Self::Target(target) => target == label,
-            Self::Package(base) => base == package,
-            Self::Recursive(base) => package
-                .strip_prefix(base.as_str())
-                .is_some_and(|rest| rest.is_empty() || rest.starts_with('/') || base.ends_with('/')),
+        if self.packages.contains(package) {
+            return true;
+        }
+        // The package itself, each parent directory, then the cell root (`cell//`).
+        let mut directory = package;
+        loop {
+            if self.directories.contains(directory) {
+                return true;
+            }
+            match directory.rfind('/') {
+                Some(slash) if directory[..slash].ends_with('/') => {
+                    return self.directories.contains(&directory[..=slash]);
+                }
+                Some(slash) => directory = &directory[..slash],
+                None => return false,
+            }
         }
     }
 }
